{
  "name": "poulina-sso-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:shared": "ng build shared-auth --configuration=production",
    "build:sso": "ng build sso --configuration=production --base-href=/sso/",
    "build:rh": "ng build rh-app --configuration=production --base-href=/rh/",
    "build:finance": "ng build finance-app --configuration=production --base-href=/finance/",
    "build:dashboard": "ng build dashboard-app --configuration=production --base-href=/dashboard/",
    "build:all": "npm run build:shared && npm run build:sso && npm run build:rh && npm run build:finance && npm run build:dashboard",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "start:sso": "ng serve sso --port 4200 --proxy-config projects/sso/proxy.conf.json",
    "start:rh": "ng serve rh-app --port 3001 --proxy-config projects/rh-app/proxy.conf.json",
    "start:finance": "ng serve finance-app --port 3002 --proxy-config projects/finance-app/proxy.conf.json",
    "start:dashboard": "ng serve dashboard-app --port 3003 --proxy-config projects/dashboard-app/proxy.conf.json",
    "start:all": "concurrently \"npm:start:sso\" \"npm:start:rh\" \"npm:start:finance\" \"npm:start:dashboard\"",
    "docker:build": "docker build -t poulina-sso-frontend:latest .",
    "docker:run": "docker run -d -p 80:80 --name poulina-sso-frontend poulina-sso-frontend:latest",
    "docker:stop": "docker stop poulina-sso-frontend || true && docker rm poulina-sso-frontend || true",
    "docker:logs": "docker logs -f poulina-sso-frontend",
    "docker:push": "docker tag poulina-sso-frontend:latest ${DOCKER_USERNAME:-poulina}/poulina-sso-frontend:latest && docker push ${DOCKER_USERNAME:-poulina}/poulina-sso-frontend:latest",
    "clean": "rimraf dist node_modules",
    "clean:dist": "rimraf dist",
    "clean:modules": "rimraf node_modules",
    "prebuild": "npm run clean:dist || echo 'Clean skipped'"
  },

  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/language-service": "^21.2.0",
    "@types/node": "^20.17.19",
    "concurrently": "^10.0.3",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "rimraf": "^5.0.10",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
